# Crate Configuration
TZ=Europe/Madrid
PUID=1000
PGID=1000
DOMAIN=example.com
CRATE_INSTANCE_NAME=Crate
CRATE_PUBLIC_API_BASE_URL=https://api.example.com
CRATE_CORS_EXTRA_ORIGINS=
LANGUAGE=es
# Admin Users pane: derived inactivity label threshold, in days.
CRATE_USER_INACTIVE_AFTER_DAYS=30
CRATE_IMAGE_REGISTRY=ghcr.io
CRATE_IMAGE_OWNER=thecrateapp
CRATE_IMAGE_TAG=latest

# Directories
DATA_DIR=./data
CACHE_DIR=./data/cache
MEDIA_DIR=./media
MUSIC_DIR=./media/music
DOWNLOADS_DIR=./media/downloads/soulseek
CRATE_CONFIG_FILE=./app/config.yaml

# Ports
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TIDARR_PORT=8484
SLSKD_PORT=5030
SLSKD_LISTEN_PORT=50300
CRATE_API_PORT=8585
CRATE_UI_PORT=8580
NGINX_PORT=8090

# Cloudflare
CF_DNS_API_TOKEN=

# Service credentials
TIDARR_PASSWORD=
SLSKD_API_KEY=
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=

# External APIs
LASTFM_APIKEY=
LASTFM_API_SECRET=
FANART_API_KEY=
SPOTIFY_ID=
SPOTIFY_SECRET=
SETLISTFM_API_KEY=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
TICKETMASTER_API_KEY=
TIDAL_COUNTRY_CODE=ES

# Bandcamp integration
# The credential bridge is risk-accepted and requires an isolated broker command.
CRATE_BANDCAMP_WEB_CREDENTIAL_BRIDGE_ENABLED=false
CRATE_BANDCAMP_CREDENTIAL_BRIDGE_BACKEND=browser
CRATE_BANDCAMP_CREDENTIAL_BRIDGE_COMMAND=
CRATE_BANDCAMP_CREDENTIAL_BRIDGE_TIMEOUT=120
CRATE_BANDCAMP_COLLECTION_SYNC_BACKEND=web
CRATE_BANDCAMP_COLLECTION_SYNC_TIMEOUT=300
CRATE_BANDCAMP_COLLECTION_SYNC_PAGE_SIZE=100
CRATE_BANDCAMP_COLLECTION_SYNC_MAX_PAGES=50
CRATE_BANDCAMP_DOWNLOAD_BACKEND=web
CRATE_BANDCAMP_DOWNLOAD_TIMEOUT=7200

# LLM providers
# Optional. If empty, Crate auto-selects Gemini when a Gemini key is present.
# Ollama remains supported only as an explicitly configured external provider.
LLM_PROVIDER=
OLLAMA_URL=
GEMINI_API_KEY=
AUDIOMUSE_GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PostgreSQL superuser bootstrap
POSTGRES_SUPERUSER_USER=crate
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_SUPERUSER_DB=crate

# PostgreSQL app user
CRATE_POSTGRES_USER=crate
CRATE_POSTGRES_PASSWORD=
CRATE_POSTGRES_DB=crate

# Redis
REDIS_PASSWORD=change-me-redis-password
# Optional overrides for external/shared Redis deployments. If omitted,
# Compose uses its separate cache and durable Redis services.
# REDIS_CACHE_URL=redis://:password@cache.example:6379/0
# REDIS_DURABLE_URL=redis://:password@durable.example:6379/0

# Auth
JWT_SECRET=
CRATE_FEDERATION_SUBJECT_SECRET=
CRATE_FEDERATION_CURSOR_SECRET=
CRATE_FEDERATION_DELTA_RETENTION_DAYS=90
CRATE_FEDERATION_CATALOG_PAGE_MAX_BYTES=2097152
CRATE_FEDERATION_IMPORT_MAX_BYTES=100000000000
CRATE_FEDERATION_IMPORT_PEER_RESERVED_BYTES=100000000000
CRATE_FEDERATION_IMPORT_GLOBAL_RESERVED_BYTES=250000000000
CRATE_FEDERATION_IMPORT_FREE_HEADROOM_BYTES=10737418240
CRATE_FEDERATION_IMPORT_LEASE_SECONDS=18000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NATIVE_OAUTH_EXCHANGE_ENABLED=false
NATIVE_OAUTH_LEGACY_REDIRECT_ENABLED=true
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
DEFAULT_ADMIN_PASSWORD=admin

# Read plane
READPLANE_ENABLED=true
READPLANE_ENABLE_SSE=true
READPLANE_ROUTE_MODE=active
READPLANE_FALLBACK_ENABLED=true
READPLANE_FALLBACK_TIMEOUT_MS=3000
READPLANE_FALLBACK_FAILURE_THRESHOLD=5
READPLANE_FALLBACK_OPEN_SECONDS=10
READPLANE_AUTH_CACHE_TTL_SECONDS=15
READPLANE_AUTH_CACHE_MAX_ENTRIES=2048
READPLANE_FEDERATION_PROXY_ENABLED=true
CRATE_READPLANE_SERVICE_TOKEN=
READPLANE_FEDERATION_CONTROL_TIMEOUT_MS=2000
READPLANE_FEDERATION_CONNECT_TIMEOUT_MS=5000
READPLANE_FEDERATION_HEADER_TIMEOUT_MS=10000
READPLANE_MAX_DB_CONNS=8
READPLANE_MIN_DB_CONNS=1
READPLANE_QUERY_TIMEOUT_MS=800
READPLANE_SNAPSHOT_MAX_AGE_SECONDS=600
READPLANE_STALE_MAX_AGE_SECONDS=3600
READPLANE_STATS_SNAPSHOT_MAX_AGE_SECONDS=300
READPLANE_STATS_STALE_MAX_AGE_SECONDS=86400
READPLANE_SESSION_TOUCH_INTERVAL_SECONDS=60
READPLANE_LOCAL_MEDIA_ENABLED=false
READPLANE_MUSIC_ROOT=/music
READPLANE_CACHE_ROOT=/cache

# Bounded PostgreSQL waits. Worker-specific statement budgets can be
# overridden independently in docker-compose.yaml.
CRATE_SQLALCHEMY_POOL_TIMEOUT_SECONDS=5
CRATE_POSTGRES_CONNECT_TIMEOUT_SECONDS=3
CRATE_POSTGRES_STATEMENT_TIMEOUT_MS=15000
CRATE_POSTGRES_LOCK_TIMEOUT_MS=3000
# Worker/projector defaults are intentionally larger than interactive API reads.
CRATE_WORKER_POSTGRES_STATEMENT_TIMEOUT_MS=900000
CRATE_PROJECTOR_POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Federation transport
# Development harness only. Production federation always requires HTTPS.
CRATE_FEDERATION_DEV_ALLOW_HTTP=false
# Development harness only. Production federation only permits public networks.
CRATE_FEDERATION_DEV_ALLOW_PRIVATE_NETWORKS=false

# Media/download workers
CRATE_MEDIA_WORKER_MAX_ACTIVE=1
STREAM_TRANSCODE_MAX_CONCURRENT=1
CRATE_STREAM_CACHE_MAX_BYTES=12884901888
CRATE_STREAM_CACHE_LOW_WATERMARK_BYTES=10737418240
CRATE_STREAM_CACHE_MAX_IDLE_SECONDS=2592000
CRATE_STREAM_CACHE_ORPHAN_GRACE_SECONDS=3600
CRATE_STREAM_CACHE_CLEANUP_MAX_FILES=100000
CRATE_SSE_REDIS_MAX_CONNECTIONS=128

# Background backpressure
CRATE_RESOURCE_GOVERNOR_ENABLED=true
CRATE_RESOURCE_MAX_LOAD_RATIO=0.85
CRATE_RESOURCE_MAX_IOWAIT_PERCENT=25
CRATE_RESOURCE_MAX_SWAP_PERCENT=30
CRATE_RESOURCE_MIN_SWAP_USED_MB=512
CRATE_RESOURCE_MIN_MEMORY_AVAILABLE_PERCENT=15
CRATE_RESOURCE_MAX_ACTIVE_USERS=0
CRATE_RESOURCE_MAX_ACTIVE_STREAMS=0
CRATE_RESOURCE_DEFER_SECONDS=300
CRATE_MAINTENANCE_WINDOW_ENABLED=true
CRATE_MAINTENANCE_WINDOW_START=02:00
CRATE_MAINTENANCE_WINDOW_END=07:00
CRATE_MAINTENANCE_WINDOW_FINGERPRINT_LIMIT=1000

# Optional local-dev Soulseek credentials.
# Keep these separate from the main/prod Soulseek account so a local slskd
# does not kick the production instance off the network.
DEV_SLSKD_SLSK_USERNAME=
DEV_SLSKD_SLSK_PASSWORD=
